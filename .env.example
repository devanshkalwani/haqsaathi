# ---------- Supabase (Dashboard → Project Settings → API) ----------
# Without these, the app uses the sample data in src/data/.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. SERVER ONLY. Never share it or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin panel (/admin) ----------
# Choose a long password. Anyone with it can edit schemes.
ADMIN_PASSWORD=

# ---------- AI chat (optional) ----------
# Without this, the chat uses simple template answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
